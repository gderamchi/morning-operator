{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE schedules your morning alarm and opens your approved morning when you stop it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE programme votre réveil et ouvre votre matinée approuvée quand vous l’arrêtez."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads your schedule for spoken briefings and saves calendar events only when you confirm them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit votre agenda pour les récaps lus à voix haute et n’enregistre des événements que lorsque vous les confirmez."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE adds the calendar event you review and choose to save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE ajoute l’événement que vous avez relu et choisi d’enregistrer."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE listens during your morning so you can interrupt or ask a question. Local listening stays on this iPhone. If you choose ElevenLabs conversation, your microphone audio is sent to ElevenLabs. Listening stops when you end the morning or leave the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE vous écoute pendant votre matin pour répondre à vos questions et interruptions. L’écoute locale reste sur cet iPhone. Si vous choisissez la conversation ElevenLabs, votre voix est transmise à ElevenLabs. L’écoute s’arrête en quittant l’app ou en arrêtant le matin."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE saves the reminders you confirm and can read reminders for your morning briefing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE enregistre les rappels que vous confirmez et peut lire vos rappels pour le récap du matin."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you start a recording, MORE captures the screen content you explicitly share to help understand your morning routine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous lancez un enregistrement, MORE capture le contenu de l’écran que vous partagez explicitement pour mieux comprendre votre routine du matin."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE transcribes your requested voice commands and drafts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE transcrit les commandes vocales et les notes que vous dictez."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Foreground location for weather and local solar position. Approximate location is sufficient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE uses your current location while open for local weather and a sky that follows the sun. An approximate location is enough."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand MORE est ouvert, votre position apporte la météo locale et un ciel qui suit le soleil. Une position approximative suffit."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Read-only sleep, requested only after an explicit choice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads sleep, resting heart rate, heart rate variability and breathing rate from Apple Health when you choose to include them in your morning. It never writes health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit le sommeil, la fréquence cardiaque au repos, sa variabilité et la fréquence respiratoire dans Santé Apple lorsque vous choisissez de les inclure dans votre matin. MORE ne modifie aucune donnée Santé."
          }
        }
      }
    }
  },
  "version": "1.0"
}
