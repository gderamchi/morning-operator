# Real secrets belong only on the server. Leave this example blank.
COMPOSIO_API_KEY=
# Optional private voice agent; no secrets or unrestricted paid token endpoint in the app.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
MORE_VOICE_INSTALLATIONS_JSON=[]
# Map real toolkit slugs to {name, authConfigID, version}. Versions must be pinned.
# Custom OAuth toolkits such as twitter/tiktok use this same map, only after a
# real auth config exists in the selected project. Do not add placeholder IDs.
# Verified available pins on 2026-10-15: twitter=20261007_00, tiktok=20260917_00.
# Provider developer credentials belong in Composio's custom auth config, not here.
COMPOSIO_TOOLKITS_JSON={}
MORE_PUBLIC_BASE_URL=
MORE_AUTH_CALLBACK_URL=more://composio/callback
MORE_CALLBACK_URLS_JSON=["more://composio/callback","moreqa://composio/callback"]
MORE_DATA_DIR=./data
COMPOSIO_TIMEOUT_MS=20000
HOST=127.0.0.1
PORT=8787
