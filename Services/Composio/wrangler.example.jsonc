{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "more-composio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "more-composio",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "ratelimits": [
    { "name": "ENROLLMENT_LIMITER", "namespace_id": "61015001", "simple": { "limit": 10, "period": 60 } },
    { "name": "REQUEST_LIMITER", "namespace_id": "61015002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "COMPOSIO_TOOLKITS_JSON": "{}",
    "MORE_AUTH_CALLBACK_URL": "more://composio/callback",
    "MORE_CALLBACK_URLS_JSON": "[\"more://composio/callback\",\"moreqa://composio/callback\"]",
    "MORE_PUBLIC_BASE_URL": "https://REPLACE_WITH_WORKER.workers.dev",
    "COMPOSIO_TIMEOUT_MS": "20000"
  }
}
